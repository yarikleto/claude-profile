#!/usr/bin/env bash
# claude-profile — Switch between Claude Code configuration profiles
# https://github.com/yarikleto/claude-profile
set -euo pipefail

# Git exports repository-local variables (GIT_DIR, GIT_INDEX_FILE, ...) into
# hook subprocesses. Left in place, every git call below would operate on the
# caller's repository instead of the profile's — potentially committing
# ~/.claude and .claude.json onto a user branch.
unset $(git rev-parse --local-env-vars 2>/dev/null) 2>/dev/null || true

# The store holds tracked settings/MCP config — secrets. Create every store
# dir, temp, and Git object private to the owner. Set before any file is made.
umask 077

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

source "$SCRIPT_DIR/lib/output.sh"
source "$SCRIPT_DIR/lib/config.sh"
source "$SCRIPT_DIR/lib/profile_safety.sh"
source "$SCRIPT_DIR/lib/git.sh"
source "$SCRIPT_DIR/lib/state.sh"
source "$SCRIPT_DIR/lib/files.sh"
source "$SCRIPT_DIR/lib/restore.sh"
source "$SCRIPT_DIR/commands/profile.sh"
source "$SCRIPT_DIR/commands/info.sh"
source "$SCRIPT_DIR/commands/history.sh"
source "$SCRIPT_DIR/commands/ui.sh"

cmd="${1:-help}"
shift 2>/dev/null || true

# Mutating commands take an exclusive lock — see lib/state.sh (_acquire_lock).
# statusline is included: `statusline install` writes both store and live
# settings.json, so it can race a switch; locking its usage path too is harmless.
command_mutates=false
case "$cmd" in
  new|fork|use|switch|save|deactivate|off|edit|delete|rm|restore|statusline)
    command_mutates=true
    ;;
esac

# Format-migrate the store before dispatch — see _migrate_store_format in
# lib/state.sh. Writers lock first, then migrate, so a store the lock itself
# created is stamped too. Read-only commands migrate only on a free lock (so
# list/history stay usable mid-write) and release it, or a pager blocks writes.
if [[ "$command_mutates" == true ]]; then
  _acquire_lock
  if _store_needs_migration; then
    _migrate_store_format || true
  fi
  _refuse_newer_store_format_for_write
elif _store_needs_migration; then
  if _try_acquire_lock; then
    _migrate_store_format || true
    _release_lock
  fi
fi

case "$cmd" in
  new)            cmd_new "$@" ;;
  fork)           cmd_fork "$@" ;;
  use|switch)     cmd_use "$@" ;;
  save)           cmd_save "$@" ;;
  deactivate|off) cmd_deactivate "$@" ;;
  list|ls)        cmd_list "$@" ;;
  current)        cmd_current "$@" ;;
  show|info)      cmd_show "$@" ;;
  edit)           cmd_edit "$@" ;;
  delete|rm)      cmd_delete "$@" ;;
  history|log)    cmd_history "$@" ;;
  diff)           cmd_diff "$@" ;;
  restore)        cmd_restore "$@" ;;
  statusline)     cmd_statusline "$@" ;;
  version|-v|--version) echo "claude-profile $VERSION" ;;
  help|--help|-h)
    echo -e "${BOLD}claude-profile${NC} ${DIM}v$VERSION${NC} — Switch between Claude Code configurations

${CYAN}${BOLD}USAGE${NC}
  claude-profile ${DIM}<command> [options]${NC}

${CYAN}${BOLD}COMMANDS${NC}
  ${BOLD}new${NC} ${DIM}<name> [--force]${NC}          Create a clean empty profile
  ${BOLD}fork${NC} ${DIM}<name>${NC}                   Copy current state into a new profile
  ${BOLD}use${NC} ${DIM}<name> [--force]${NC}          Switch to a profile
                                  ${DIM}--force: discard unsaved detached config${NC}
  ${BOLD}list${NC}                          List all profiles
  ${BOLD}current${NC}                       Show active profile name
  ${BOLD}show${NC} ${DIM}[name]${NC}                   Show profile contents
  ${BOLD}edit${NC} ${DIM}[name]${NC}                   Open profile in editor
  ${BOLD}delete${NC} ${DIM}<name> [-f]${NC}            Delete a profile
  ${BOLD}deactivate${NC} ${DIM}[--keep]${NC}             Turn off profiles, restore original
                                  ${DIM}--keep: detach without restoring backup${NC}

${CYAN}${BOLD}HISTORY${NC}
  ${BOLD}save${NC} ${DIM}[name] [-m message]${NC}      Save & commit current state
  ${BOLD}history${NC} ${DIM}[name]${NC}                View change history (git log)
  ${BOLD}diff${NC} ${DIM}[name] [commit|date]${NC}     Show changes (unsaved or since ref)
  ${BOLD}restore${NC} ${DIM}[name] <commit|date>${NC}  Restore profile to a point in time

${CYAN}${BOLD}UI INTEGRATION${NC}
  ${BOLD}statusline${NC} ${DIM}install|uninstall${NC}   Add/remove profile from Claude Code status

${CYAN}${BOLD}OTHER${NC}
  ${BOLD}version${NC}                       Print version
  ${BOLD}help${NC}                          Show this help

${CYAN}${BOLD}EXAMPLES${NC}
  ${DIM}\$${NC} claude-profile fork default          ${DIM}# Save current setup as \"default\"${NC}
  ${DIM}\$${NC} claude-profile new experiment        ${DIM}# Clean empty profile${NC}
  ${DIM}\$${NC} claude-profile fork review           ${DIM}# Fork current profile${NC}
  ${DIM}\$${NC} claude-profile use review            ${DIM}# Switch to profile${NC}

  ${DIM}\$${NC} claude-profile statusline install           ${DIM}# Profile in Claude Code${NC}

${CYAN}${BOLD}WHAT GETS SWITCHED${NC}
  Everything in ${BOLD}~/.claude/${NC} and ${BOLD}~/.claude.json${NC}

${CYAN}${BOLD}FILES${NC}
  Profiles dir:  ${BOLD}\$CLAUDE_PROFILE_HOME${NC} ${DIM}(default: ~/.local/share/claude-profile)${NC}
"
    ;;
  *)
    err "Unknown command: $cmd"
    echo "Run 'claude-profile help' for usage"
    exit 1
    ;;
esac
